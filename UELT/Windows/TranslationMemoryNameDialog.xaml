<Window x:Class="UELT.TranslationMemoryNameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нова пам’ять перекладів" SizeToContent="Height" Width="320" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="5">
        <TextBlock Text="Назва проєкту:" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameTextBox" Height="25"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Content="Створити" Width="75" MinHeight="25" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>