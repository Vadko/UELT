<Window x:Class="UELT.LocresCompareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Порівняння двох locres" Width="600" Height="450" MinWidth="500" MinHeight="350" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Старий locres:" Margin="0,0,0,4" Foreground="{DynamicResource TextForegroundBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OldPathBox" Grid.Column="0" IsReadOnly="True" Padding="4,3" Background="{DynamicResource DataGridBackgroundBrush}"
                         Foreground="{DynamicResource TextForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         AllowDrop="True" PreviewDragOver="PathBox_DragOver" Drop="OldPathBox_Drop"/>
                <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Width="25" MinHeight="25" Click="BrowseOld_Click"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Новий locres (з оновлення):" Margin="0,0,0,4" Foreground="{DynamicResource TextForegroundBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewPathBox" Grid.Column="0" IsReadOnly="True" Padding="4,3" Background="{DynamicResource DataGridBackgroundBrush}"
                         Foreground="{DynamicResource TextForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         AllowDrop="True" PreviewDragOver="PathBox_DragOver" Drop="NewPathBox_Drop"/>
                <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Width="25" MinHeight="25" Click="BrowseNew_Click"/>
            </Grid>
        </StackPanel>
        <Button Grid.Row="2" x:Name="CompareBtn" Content="Порівняти" HorizontalAlignment="Center" Width="90" MinHeight="25" IsEnabled="False"
                Click="Compare_Click" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="3" x:Name="ResultText" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,8" FontSize="13" Visibility="Hidden"/>
        <TabControl Grid.Row="4" x:Name="ResultTabs" Visibility="Collapsed" Background="{DynamicResource WindowBackgroundBrush}">
            <TabItem Header="Нові рядки" x:Name="NewTab">
                <DataGrid x:Name="NewGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource DataGridBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Key}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Текст" Binding="{Binding NewText}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Змінені рядки" x:Name="ChangedTab">
                <DataGrid x:Name="ChangedGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource DataGridBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Key}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Старий текст" Binding="{Binding OldText}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Новий текст" Binding="{Binding NewText}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Приховані зміни" x:Name="HashChangedTab">
                <DataGrid x:Name="HashChangedGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource DataGridBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Key}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Текст" Binding="{Binding NewText}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ExportBtn" Content="Сформувати файли" Width="130" MinHeight="25" IsEnabled="False" Click="Export_Click"/>
        </Grid>
    </Grid>
</Window>