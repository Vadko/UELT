<Window x:Class="UELT.Hikaro.AddToGlossaryDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додавання до глосарію" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Виділіть слово або фразу в оригіналі, якій відповідає переклад:" TextWrapping="Wrap" Margin="0 0 0 4"/>
        <TextBox x:Name="OriginalTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Padding="4" Margin="0,0,0,8"
                 SelectionChanged="OriginalTextBox_SelectionChanged" FontSize="12"/>
        <TextBlock Grid.Row="2" Text="Обраний фрагмент:" Margin="0 0 0 2"/>
        <TextBox x:Name="SelectedOriginalBox" Grid.Row="3" IsReadOnly="True" Padding="4" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="4" Text="Переклад:" Margin="0 0 0 2"/>
        <TextBox x:Name="TranslationBox" Grid.Row="5" Height="25" Margin="0 0 0 8" KeyDown="TranslationBox_KeyDown"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Додати" Width="80" MinHeight="25" Click="OK_Click"/>
        </StackPanel>
    </Grid>
</Window>
