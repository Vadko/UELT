<Window x:Class="UELT.ReplaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заміна" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" KeyDown="Window_KeyDown"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="74"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Знайти:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TxtFind" MinHeight="25" IsEditable="True" IsTextSearchEnabled="False" VerticalContentAlignment="Center">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" MaxWidth="350" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.ContextMenu>
                <ContextMenu Background="{DynamicResource MenuBackgroundBrush}" Foreground="{DynamicResource MenuForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                             BorderThickness="1" Padding="0">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource ContextMenuItemStyle}"/>
                    </ContextMenu.Resources>
                    <MenuItem Header="Очистити" Click="TxtClear_Click" CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Вирізати" Command="ApplicationCommands.Cut"/>
                    <MenuItem Header="Копіювати" Command="ApplicationCommands.Copy"/>
                    <MenuItem Header="Вставити" Command="ApplicationCommands.Paste"/>
                </ContextMenu>
            </ComboBox.ContextMenu>
        </ComboBox>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Замінити на:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtReplace" MinHeight="25" VerticalContentAlignment="Center">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Очистити" Click="TxtClear_Click" CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Вирізати" Command="ApplicationCommands.Cut"/>
                    <MenuItem Header="Копіювати" Command="ApplicationCommands.Copy"/>
                    <MenuItem Header="Вставити" Command="ApplicationCommands.Paste"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" x:Name="BtnSwap" Content="⇅" Width="25" FontSize="18" Margin="10,0,0,0" Click="BtnSwap_Click"
                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="1" x:Name="ChkWholeWord" Checked="ChkMutualExclusive_Changed" Unchecked="ChkMutualExclusive_Changed">
                <Border Background="Transparent" Padding="0">
                    <Path Data="{StaticResource WholeWordIcon}" Fill="{DynamicResource TextForegroundBrush}" Width="20" Height="18" Stretch="Uniform"/>
                </Border>
            </CheckBox>
            <CheckBox Grid.Column="2" x:Name="ChkCaseSensitive" Margin="10,0,0,0">
                <Border Background="Transparent" Padding="0">
                    <Path Data="{StaticResource MatchCaseIcon}" Fill="{DynamicResource TextForegroundBrush}" Width="18" Height="16" Stretch="Uniform"/>
                </Border>
            </CheckBox>
            <CheckBox Grid.Column="3" x:Name="ChkExactMatch" Margin="10,0,0,0" Checked="ChkMutualExclusive_Changed" Unchecked="ChkMutualExclusive_Changed">
                <Border Background="Transparent" Padding="0">
                    <Path Data="{StaticResource ExactMatchIcon}" Fill="{DynamicResource TextForegroundBrush}" Width="16" Height="13" Stretch="Uniform"/>
                </Border>
            </CheckBox>
        </Grid>
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="1" x:Name="ChkAllTabs" Content="Знайти і замінити у всіх вкладках" Visibility="Collapsed" Margin="0"/>
        </Grid>
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnReplace" Content="Замінити все" Width="100" MinHeight="25" Click="BtnReplace_Click" IsDefault="True"/>
            </StackPanel>
            <TextBlock x:Name="LblStatus" MinHeight="20" Margin="0,5,0,0" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>