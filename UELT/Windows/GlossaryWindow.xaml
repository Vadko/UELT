<Window x:Class="UELT.Hikaro.GlossaryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UELT.Hikaro" Title="Глосарій" Height="400" MinHeight="200" Width="700" MinWidth="500" WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Пошук -->
        <TextBox Grid.Row="0" Margin="0,0,0,6" Text="{Binding GlossarySearch, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
        <!-- Таблиця глосарію -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding GlossaryView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Оригінал" Binding="{Binding Original}" Width="120" MinWidth="80" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Переклади" Width="*" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Translations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" Margin="2,1"/>
                                            <Button Grid.Column="1" Content="видалити вар." Width="90" Height="18" Margin="0,0,2,0" Click="DeleteTranslation_Click" 
                                                    DataContext="{Binding}" Padding="0,-3,0,1"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="139" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="додати вар." Width="70" Height="18" Margin="2.5,0,5,0" Click="AddTranslation_Click" Padding="0,-3,0,1"/>
                                <Button Content="видалити" Width="60" Height="18" Margin="0,0,2.5,0" Click="DeleteEntry_Click" Padding="0,-3,0,1"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>