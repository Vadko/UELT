<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>

	  <AssemblyTitle>UELT</AssemblyTitle>
	  <AssemblyDescription>Інструмент для редагування файлів локалізацій Unreal Engine.</AssemblyDescription>
	  <Company>Hikaro</Company>
	  <Product>UELT</Product>
	  <Copyright>© Hikaro 2026</Copyright>
	  <Version>1.2.1</Version>
	  <Authors>Hikaro</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CIVersion)' != ''">
    <Version>$(CIVersion)</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="donate_qr.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico" />
    <Resource Include="donate_qr.png" />
  </ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="System.Security.Cryptography.ProtectedData" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CSVHelper" Version="33.1.0" />
    <PackageReference Include="DiscordRichPresence" Version="1.5.0.51" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UAssetAPI">
      <HintPath>Lib\UAssetAPI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
