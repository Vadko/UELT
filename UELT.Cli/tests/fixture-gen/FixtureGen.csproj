<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regenerates the synthetic .uasset fixtures of the smoke test (not part of the CLI build).
       Usage: see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UAssetAPI">
      <HintPath>..\..\..\UELT\Lib\UAssetAPI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
